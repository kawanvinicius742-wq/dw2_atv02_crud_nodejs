<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar Filme</title>
  </head>
  <body>
    <nav>
      <a href="/">Início</a>
      <a href="/filmes">Filmes</a>
      <a href="/atores">Atores</a>
      <a href="/generos">Gêneros</a>
    </nav>

    <div>
      <h1>Editar Filme</h1>
      <hr />

      <form action="/filmes/alterar" method="POST">
        <label for="titulo">Título do Filme</label>
        <input
          type="text"
          name="titulo"
          id="titulo"
          required
          value="<%= filme.titulo %>"
        />

        <br /><br />

        <label for="ano">Ano de Lançamento</label>
        <input
          type="number"
          name="ano"
          id="ano"
          value="<%= filme.ano ?? '' %>"
        />

        <br /><br />

        <label for="classificacao">Classificação Indicativa</label>
        <input
          type="text"
          name="classificacao"
          id="classificacao"
          value="<%= filme.classificacao ?? '' %>"
        />

        <input type="hidden" name="id" id="id" value="<%= filme.id %>" />

        <br /><br />

        <button
          type="submit"
          onclick="return confirm('Deseja mesmo alterar este filme?');"
        >
          Alterar
        </button>

        <a href="/filmes">
          <button type="button">Cancelar</button>
        </a>
      </form>
    </div>
  </body>
</html>
