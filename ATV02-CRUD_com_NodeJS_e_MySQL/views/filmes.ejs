
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Filmes</title>
</head>
<body>

    <nav>
        <a href="/">Início</a>
        <a href="/filmes">Filmes</a>
        <a href="/atores">Atores</a>
        <a href="/generos">Gêneros</a>
    </nav>

    <main>

        <h1>Filmes</h1>

        <div>
            <h2>Cadastrar Filme</h2>

            <form action="/filmes/cadastrar" method="POST">

                <label for="titulo">Título do Filme</label>
                <input type="text" name="titulo" id="titulo" required>

                <br><br>

                <label for="ano">Ano de Lançamento</label>
                <input type="number" name="ano" id="ano">

                <br><br>

                <label for="classificacao">Classificação Indicativa</label>
                <input type="text" name="classificacao" id="classificacao">

                <br><br>

                <button type="submit">Cadastrar</button>
                <button type="reset">Limpar</button>

            </form>
        </div>

        <hr>

        <h2>Filmes Cadastrados</h2>

        <table border="1">

            <thead>
                <tr>
                    <th>Título</th>
                    <th>Ano</th>
                    <th>Classificação</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                <% filmes.forEach(filme => { %>
                    <tr>
                        <td><%= filme.titulo %></td>
                        <td><%= filme.ano %></td>
                        <td><%= filme.classificacao %></td>
                        <td>
                            <a href="/filmes/editar/<%= filme.id %>">Editar</a>
                            <a href="/filmes/excluir/<%= filme.id %>"
                               onclick="return confirm('Deseja mesmo excluir o filme <%= filme.titulo %>?')">
                                Excluir
                            </a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>

        </table>

    </main>

</body>
</html>
