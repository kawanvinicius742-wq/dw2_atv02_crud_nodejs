
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atores</title>
</head>
<body>
    <nav>
        <a href="/">Início</a>
        <a href="/filmes">Filmes</a>
        <a href="/atores">Atores</a>
        <a href="/generos">Gêneros</a>
    </nav>

    <main>
        <h1>Atores</h1>

        <h2>Cadastrar ator</h2>

        <form action="/atores/cadastrar" method="POST">
            <label>Nome:</label>
            <input type="text" name="nome" required>

            <label>Nacionalidade:</label>
            <input type="text" name="nacionalidade">

            <label>Data de nascimento:</label>
            <input type="date" name="nascimento">

            <button type="submit">Cadastrar</button>
        </form>

        <h2>Lista de atores</h2>

        <table border="1">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Nacionalidade</th>
                    <th>Nascimento</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                <% atores.forEach(ator => { %>
                    <tr>
                        <td><%= ator.nome %></td>
                        <td><%= ator.nacionalidade || "" %></td>
                        <td><%= ator.nascimento || "" %></td>
                        <td>
                            <a href="/atores/editar/<%= ator.id %>">Editar</a>
                            <a href="/atores/excluir/<%= ator.id %>"
                               onclick="return confirm('Deseja excluir este ator?')">
                                Excluir
                            </a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>
</body>
</html>
